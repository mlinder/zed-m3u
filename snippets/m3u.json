{
  "M3U header": {
    "prefix": "extm3u",
    "body": ["#EXTM3U"],
    "description": "Extended M3U header, must be the first line"
  },
  "EXTINF": {
    "prefix": "extinf",
    "body": ["#EXTINF:${1:duration},${2:title}", "${3:media.ts}"],
    "description": "Media segment: duration in seconds (-1 for live streams) and optional title"
  },
  "EXTINF (IPTV channel)": {
    "prefix": "extinf-iptv",
    "body": [
      "#EXTINF:-1 tvg-id=\"${1:channel.id}\" tvg-name=\"${2:Channel Name}\" tvg-logo=\"${3:logo.png}\" group-title=\"${4:Group}\",${2:Channel Name}",
      "${5:http://example.com/stream.m3u8}"
    ],
    "description": "IPTV channel entry with tvg-* attributes"
  },
  "HLS variant stream": {
    "prefix": "x-stream-inf",
    "body": [
      "#EXT-X-STREAM-INF:BANDWIDTH=${1:800000},AVERAGE-BANDWIDTH=${2:700000},RESOLUTION=${3:1920x1080},FRAME-RATE=${4:29.970},CODECS=\"${5:avc1.640028,mp4a.40.2}\"",
      "${6:variant.m3u8}"
    ],
    "description": "Multivariant playlist variant stream"
  },
  "HLS I-frame variant stream": {
    "prefix": "x-i-frame-stream-inf",
    "body": [
      "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=${1:150000},RESOLUTION=${2:1920x1080},CODECS=\"${3:avc1.640028}\",URI=\"${4:iframes.m3u8}\""
    ],
    "description": "Multivariant playlist I-frame (trick play) variant stream"
  },
  "HLS media rendition": {
    "prefix": "x-media",
    "body": [
      "#EXT-X-MEDIA:TYPE=${1|AUDIO,SUBTITLES,VIDEO,CLOSED-CAPTIONS|},GROUP-ID=\"${2:group}\",NAME=\"${3:English}\",LANGUAGE=\"${4:en}\",DEFAULT=${5|YES,NO|},AUTOSELECT=${6|YES,NO|},URI=\"${7:media.m3u8}\""
    ],
    "description": "Alternative rendition (audio, subtitles, video, captions)"
  },
  "HLS encryption key": {
    "prefix": "x-key",
    "body": [
      "#EXT-X-KEY:METHOD=${1|AES-128,SAMPLE-AES,SAMPLE-AES-CTR,AES-256-GCM,NONE|},URI=\"${2:https://example.com/key}\"${3:,IV=0x${4:00000000000000000000000000000000}}"
    ],
    "description": "Media segment encryption key (METHOD=NONE ends encryption)"
  },
  "HLS media initialization section": {
    "prefix": "x-map",
    "body": ["#EXT-X-MAP:URI=\"${1:init.mp4}\""],
    "description": "Media initialization section (fMP4 init segment)"
  },
  "HLS target duration": {
    "prefix": "x-targetduration",
    "body": ["#EXT-X-TARGETDURATION:${1:6}"],
    "description": "Maximum media segment duration in seconds"
  },
  "HLS protocol version": {
    "prefix": "x-version",
    "body": ["#EXT-X-VERSION:${1:3}"],
    "description": "Protocol compatibility version"
  },
  "HLS media sequence": {
    "prefix": "x-media-sequence",
    "body": ["#EXT-X-MEDIA-SEQUENCE:${1:0}"],
    "description": "Media sequence number of the first segment in the playlist"
  },
  "HLS playlist type": {
    "prefix": "x-playlist-type",
    "body": ["#EXT-X-PLAYLIST-TYPE:${1|VOD,EVENT|}"],
    "description": "Playlist mutability: VOD (immutable) or EVENT (append-only)"
  },
  "HLS independent segments": {
    "prefix": "x-independent-segments",
    "body": ["#EXT-X-INDEPENDENT-SEGMENTS"],
    "description": "Every segment can be decoded without depending on earlier ones"
  },
  "HLS byte range": {
    "prefix": "x-byterange",
    "body": ["#EXT-X-BYTERANGE:${1:length}@${2:offset}"],
    "description": "Segment is a sub-range of the following URI's resource"
  },
  "HLS discontinuity": {
    "prefix": "x-discontinuity",
    "body": ["#EXT-X-DISCONTINUITY"],
    "description": "Encoding discontinuity between the surrounding segments"
  },
  "HLS program date time": {
    "prefix": "x-program-date-time",
    "body": ["#EXT-X-PROGRAM-DATE-TIME:${1:2026-01-01T00:00:00.000Z}"],
    "description": "Absolute date/time of the first sample of the following segment"
  },
  "HLS date range": {
    "prefix": "x-daterange",
    "body": [
      "#EXT-X-DATERANGE:ID=\"${1:id}\",START-DATE=\"${2:2026-01-01T00:00:00Z}\",DURATION=${3:30.0}${4:,CLASS=\"${5:com.example.class}\"}"
    ],
    "description": "Date range (ad breaks, SCTE-35 markers, program boundaries)"
  },
  "HLS variable definition": {
    "prefix": "x-define",
    "body": ["#EXT-X-DEFINE:NAME=\"${1:name}\",VALUE=\"${2:value}\""],
    "description": "Playlist variable; reference it as {$name}"
  },
  "HLS start offset": {
    "prefix": "x-start",
    "body": ["#EXT-X-START:TIME-OFFSET=${1:0},PRECISE=${2|NO,YES|}"],
    "description": "Preferred playback start position"
  },
  "HLS session data": {
    "prefix": "x-session-data",
    "body": ["#EXT-X-SESSION-DATA:DATA-ID=\"${1:com.example.key}\",VALUE=\"${2:value}\",LANGUAGE=\"${3:en}\""],
    "description": "Arbitrary session metadata in the multivariant playlist"
  },
  "LL-HLS server control": {
    "prefix": "x-server-control",
    "body": ["#EXT-X-SERVER-CONTROL:CAN-BLOCK-RELOAD=YES,PART-HOLD-BACK=${1:3.0},CAN-SKIP-UNTIL=${2:36.0}"],
    "description": "Low-Latency HLS server capabilities"
  },
  "LL-HLS part target": {
    "prefix": "x-part-inf",
    "body": ["#EXT-X-PART-INF:PART-TARGET=${1:1.0}"],
    "description": "Low-Latency HLS partial segment target duration"
  },
  "LL-HLS partial segment": {
    "prefix": "x-part",
    "body": ["#EXT-X-PART:DURATION=${1:1.0},URI=\"${2:part.mp4}\"${3:,INDEPENDENT=YES}"],
    "description": "Low-Latency HLS partial segment"
  },
  "LL-HLS preload hint": {
    "prefix": "x-preload-hint",
    "body": ["#EXT-X-PRELOAD-HINT:TYPE=${1|PART,MAP|},URI=\"${2:next.mp4}\""],
    "description": "Low-Latency HLS hint of the next resource to request"
  },
  "HLS end list": {
    "prefix": "x-endlist",
    "body": ["#EXT-X-ENDLIST"],
    "description": "No more segments will be added to this playlist"
  }
}
